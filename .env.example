# --- Banco / fila ---
DATABASE_URL=postgresql+asyncpg://orchestrator:orchestrator@localhost:5434/orchestrator
REDIS_URL=redis://localhost:6380/0

# --- Serviços integrados ---
IDEAS_HUB_API_URL=http://localhost:8000
IDEAS_HUB_API_TIMEOUT=30

VOICE_API_URL=http://localhost:8889
VOICE_PROFILE=bernardo_v1
VOICE_GENERATION_PROFILE=narration_v1
VOICE_LANGUAGE=Portuguese
VOICE_SEED=0
VOICE_POLL_INTERVAL_SECONDS=5
VOICE_JOB_TIMEOUT_SECONDS=1800
VOICE_CREATE_TIMEOUT_SECONDS=30
VOICE_STATUS_TIMEOUT_SECONDS=15
VOICE_DOWNLOAD_TIMEOUT_SECONDS=120
VOICE_HTTP_MAX_RETRIES=2
VOICE_HTTP_BACKOFF_SECONDS=1
VOICE_QUALITY_MAX_RETRIES=2

# Media Indexer public HTTP API (Visual Director / Stage 14)
MEDIA_INDEXER_API_URL=http://localhost:8012
MEDIA_INDEXER_API_TIMEOUT_SECONDS=30
MEDIA_INDEXER_HTTP_MAX_RETRIES=2
MEDIA_INDEXER_HTTP_BACKOFF_SECONDS=0.25

# Stage 16 Video Composer (Stage 17 orchestration uses final mode only)
VIDEO_COMPOSER_API_URL=http://localhost:8013
VIDEO_COMPOSER_API_URL_DOCKER=http://host.docker.internal:8013
VIDEO_COMPOSER_HTTP_TIMEOUT_SECONDS=15
VIDEO_COMPOSER_HTTP_MAX_RETRIES=2
VIDEO_COMPOSER_HTTP_BACKOFF_SECONDS=0.5
VIDEO_COMPOSER_POLL_INTERVAL_SECONDS=2
VIDEO_COMPOSER_RENDER_TIMEOUT_SECONDS=3600
VIDEO_COMPOSER_RENDER_PROFILE=youtube_1080p30_v1
PRODUCTION_QA_STRATEGY_VERSION=production_qa_v1
PRODUCTION_QA_DEEP_MAX_VIDEO_BYTES=10737418240
PRODUCTION_QA_TASK_MAX_RETRIES=2
PRODUCTION_QA_TASK_RETRY_SECONDS=5

# --- Armazenamento ---
AUDIO_STORAGE_PATH=/data/audio
PRONUNCIATION_GLOSSARY_PATH=config/pronunciation_glossary.yaml
PRONUNCIATION_LOCALE=pt-BR
TEXT_NORMALIZER_VERSION=pt_br_text_normalizer_v1

# --- Parâmetros calibráveis ---
SILENCIO_ENTRE_BLOCOS_MS=500
AUDIO_FINAL_SAMPLE_RATE=48000
AUDIO_TARGET_LUFS=-16
AUDIO_MAX_TRUE_PEAK_DB=-1
AUDIO_TRUE_PEAK_TOLERANCE_DB=0.02
AUDIO_TRUE_PEAK_SAFETY_MARGIN_DB=0.05
AUDIO_MIN_ACCEPTABLE_LUFS=-18
AUDIO_MAX_ACCEPTABLE_LUFS=-15
AUDIO_DURATION_TOLERANCE_SECONDS=0.01
AUDIO_BLOCK_MAX_DURATION_SECONDS=120
AUDIO_BLOCK_MAX_SECONDS_PER_CHAR=0.5
AUDIO_BLOCK_DURATION_GRACE_SECONDS=15
WORKFLOW_MAX_TENTATIVAS=3

TRANSCRIPTION_MODEL=small
TRANSCRIPTION_DEVICE=cpu
TRANSCRIPTION_COMPUTE_TYPE=int8
TRANSCRIPTION_LANGUAGE=

NARRATION_ALIGNMENT_STRATEGY_VERSION=narration_alignment_v1
NARRATION_ALIGNMENT_FUZZY_MIN_SCORE=0.72
NARRATION_ALIGNMENT_AMBIGUITY_DELTA=0.03
NARRATION_ALIGNMENT_MIN_SPEECH_COVERAGE=0.60
NARRATION_ALIGNMENT_BLOCK_TOLERANCE_SECONDS=0.05
NARRATION_ALIGNMENT_TIMESTAMP_TOLERANCE_SECONDS=0.25
NARRATION_ALIGNMENT_MAX_TOKENS=2500
NARRATION_ALIGNMENT_MAX_CELLS=2000000
NARRATION_QUALITY_POLICY_VERSION=narration_speech_quality_v1
NARRATION_QUALITY_MAX_REPEATED_NGRAM_OCCURRENCES=4

# Visual Director deterministic search policy
VISUAL_DIRECTOR_STRATEGY_VERSION=visual_director_v1
VISUAL_DIRECTOR_MAX_QUERIES=100
VISUAL_DIRECTOR_SEARCH_TOP_K=5
VISUAL_DIRECTOR_MAX_ALTERNATIVES=2
VISUAL_DIRECTOR_SEARCH_CONCURRENCY=4
VISUAL_DIRECTOR_MIN_SEMANTIC_SCORE=0.25

# Stage 15 — Production Timeline (metadados apenas; sem renderização)
PRODUCTION_TIMELINE_STRATEGY_VERSION=production_timeline_v1
PRODUCTION_TIMELINE_SCHEMA_VERSION=production_timeline_schema_v1
PRODUCTION_TIMELINE_VALIDATOR_VERSION=production_timeline_validator_v1
PRODUCTION_TIMELINE_MIN_VISUAL_SECONDS=0.5
PRODUCTION_TIMELINE_MAX_SOURCES_PER_QUERY=2
PRODUCTION_TIMELINE_GAP_FILL_ENABLED=true
PRODUCTION_TIMELINE_COALESCE_CONTIGUOUS=true

# --- API ---
API_PORT=8001
CORS_ORIGINS=http://localhost:5174
JSON_LOGGING=true

# --- Frontend ---
VITE_API_URL=http://localhost:8011
